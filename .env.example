# Copy this file to .env and fill in real values before starting the server.
# Never commit your real .env file to version control.

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000,https://your-live-site.com

# Auth
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
# Plain-text password used ONLY the very first time you run `npm run seed`.
# After seeding, the password is stored as a bcrypt hash in the database and
# this value is ignored. Change the password from the admin panel afterwards.
ADMIN_INITIAL_PASSWORD=codenavs2026

# Telegram (optional — leave blank to disable Telegram delivery)
# Create a bot with @BotFather to get a token, then message the bot once and
# visit https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (optional — leave blank to disable WhatsApp delivery)
# Requires a Meta developer app with WhatsApp product enabled.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=

# Email (optional — leave blank to disable email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=info@codenavs.com
